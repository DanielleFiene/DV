Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.html

<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

ErrorDocument 404 /404.html
ErrorDocument 403 /403.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} ^(www\.)?dvdesign\.studio$ [NC]
  RewriteRule ^ https://www.dvdesign.studio%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^dvdesign\.studio$ [NC]
  RewriteRule ^ https://www.dvdesign.studio%{REQUEST_URI} [R=301,L]

  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^en/index\.html$ /en/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(css|js|svg|woff2)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 5 minutes"
</IfModule>
